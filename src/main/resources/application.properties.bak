# ============================================================
# 平台基础配置
# ============================================================
# 平台基础地址（含协议+域名+端口，末尾不要加 /）
server.url=https://basy.ndctcm.cn:1443
# 机构编码（上传文件时作为 orgCode 参数提交，如 TCMMS32031）
server.orgCode=TCMMS32031

# ============================================================
# 鉴权配置
# ============================================================
# 根据平台实际鉴权方式，填写以下一种或多种配置。
# 大多数情况下只需配置 Cookie 即可。
#
# 【方式1 - Cookie 鉴权（最常用）】
# 该平台为 Java Web 应用，通常使用 JSESSIONID 会话 Cookie 鉴权。
# 获取方法：
#   1. 浏览器登录 https://basy.ndctcm.cn:1443 平台
#   2. F12 打开开发者工具 -> Network 标签页
#   3. 点击任意 XHR 请求 -> Request Headers -> 找到 Cookie 头
#   4. 复制完整 Cookie 值粘贴到下方
# 示例: JSESSIONID=abc123def456; otherCookie=value
auth.cookie=
#
# 【方式2 - Token 鉴权】
# 如平台使用 Bearer Token 鉴权，填写 token（不含 "Bearer " 前缀）
auth.token=
#
# 【方式3 - Basic 认证】
# 如平台使用 HTTP Basic 认证，填写用户名密码
auth.username=
auth.password=
#
# 【方式4 - 自定义请求头鉴权】
# 如平台需要特殊请求头（如 X-Auth-Token），用分号分隔多个头
# 格式: X-Auth-Token=abc123;X-Custom-Header=value
auth.customHeaders=

# ============================================================
# SSL 配置
# ============================================================
# 是否信任所有 SSL 证书（平台使用 HTTPS 1443 端口，如为自签名证书则设为 true）
ssl.trustAll=true

# ============================================================
# 上传配置
# ============================================================
# 本地待上传文件目录（将上传该目录下所有匹配的文件）
upload.fileDir=./files
# 文件扩展名过滤（多个用逗号分隔，如 .zip,.rar）
upload.fileExtension=.zip
# 请求超时时间（秒）
upload.timeoutSeconds=120
# 上传失败重试次数
upload.retryCount=2

# ============================================================
# 日志查询配置（接口2 logList）
# ============================================================
# 上传完成后轮询 logList 的间隔（秒）
log.pollIntervalSeconds=5
# 轮询最大等待时间（秒），超时则放弃等待
log.pollTimeoutSeconds=300
# logList 每页查询条数（设为1可获取最新一条记录）
log.pageSize=1

# ============================================================
# 异常日志下载配置（接口3 getFileErrorLog）
# ============================================================
# 异常日志保存目录
download.errorLogDir=./error_logs
